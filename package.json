{
    "name": "@onesoftnet/sudobot",
    "version": "11.24.3",
    "type": "module",
    "description": "A Discord bot for moderation purposes.",
    "author": {
        "name": "Ar Rakin",
        "email": "rakinar2@osndevs.org",
        "url": "https://virtual-designer.github.io"
    },
    "main": "build/out/main/main.js",
    "license": "AGPL-3.0-or-later",
    "keywords": [
        "bot",
        "discord-bot",
        "moderation",
        "automoderation",
        "discord-moderation",
        "discord-moderation-bot",
        "discord-automoderation",
        "discord-automoderation-bot"
    ],
    "homepage": "https://github.com/onesoft-sudo/sudobot",
    "icon": "./assets/icon.png",
    "readme": "https://github.com/onesoft-sudo/sudobot#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/onesoft-sudo/sudobot"
    },
    "bugs": {
        "url": "https://github.com/onesoft-sudo/sudobot/issues",
        "email": "sudobot@osndevs.org"
    },
    "_meta": {
        "release_codename": "Next Version",
        "release_short_codename": "Next"
    },
    "funding": {
        "type": "paypal",
        "url": "https://www.sudobot.org/donate?utm_source=package-json&utm_medium=funding&utm_campaign=paypal"
    },
    "scripts": {
        "prepare": "node bin/prepare",
        "migrate": "drizzle-kit migrate",
        "start": "node build/out/main/typescript/index.js",
        "start:bun": "bun src/main/typescript/boot/bun.ts",
        "start:docker": "sh ./docker/start-container.sh",
        "start:blazew": "node build/out/main/typescript/index.js",
        "dev": "bun run src/main/typescript/index.ts",
        "dev:single": "bun run src/main/typescript/boot/bun.ts",
        "dev:node": "node src/main/typescript/index.ts",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier -w src && eslint src --fix",
        "build": "tsc && mv build/out/src _build && rm -fr build/out && mv _build build/out && cp -r src/main/resources build/out/main",
        "bundle": "sh bin/genimports src/main/typescript && ncc build src/main/typescript/bundle.ts -o build && rm -rf build/src",
        "sea:linux:x86_64": "pnpm run bundle && sh bin/gensea linux:x86_64",
        "sea:all": "pnpm run bundle && sh bin/gensea all",
        "clean": "rm -frv build tsconfig.tsbuildinfo; make clean",
        "test": "vitest"
    },
    "dependencies": {
        "@msgpack/msgpack": "3.1.3",
        "ascii-table3": "^1.0.3",
        "axios": "1.19.0",
        "chalk": "6.0.0",
        "date-fns": "4.4.0",
        "discord.js": "14.27.0",
        "dotenv": "17.4.2",
        "drizzle-orm": "0.45.2",
        "figlet": "1.11.4",
        "ioredis": "6.0.0",
        "json5": "2.2.3",
        "lru-cache": "11.5.2",
        "mlkem": "2.7.0",
        "pg": "8.23.0",
        "re2js": "2.8.6",
        "reflect-metadata": "0.2.2",
        "semver": "^7.8.5",
        "tslib": "2.8.1",
        "unidecode": "^1.1.0",
        "uuid": "14.0.1",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.1",
        "@commitlint/config-conventional": "21.2.0",
        "@commitlint/types": "^21.2.0",
        "@eslint/js": "^10.0.1",
        "@onesoftnet/blazebuild": "latest",
        "@onesoftnet/override": "^1.0.3",
        "@onesoftnet/pm2-config": "^0.0.7",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/bun": "1.3.14",
        "@types/module-alias": "^2.0.4",
        "@types/node": "26.2.0",
        "@types/pg": "^8.21.0",
        "@types/unidecode": "^1.1.0",
        "@typescript-eslint/utils": "8.67.0",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vercel/ncc": "0.44.1",
        "@vitest/coverage-v8": "4.1.10",
        "discord-api-types": "0.38.53",
        "drizzle-kit": "0.31.10",
        "eslint": "10.8.1",
        "eslint-plugin-import": "^2.32.0",
        "husky": "9.1.7",
        "prettier": "3.9.6",
        "typedoc": "0.28.20",
        "typedoc-plugin-rename-defaults": "^0.7.3",
        "typedoc-theme-hierarchy": "6.0.0",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "typescript-eslint": "8.67.0",
        "unplugin-swc": "^1.5.10",
        "vitest": "4.1.10"
    },
    "_moduleAliases": {
        "@buildSrc": "build_src/build/main/typescript",
        "@sudobot": "build/out",
        "@framework": "build/out/framework/typescript",
        "@main": "build/out/main/typescript",
        "@api": "build/out/api/typescript",
        "@schemas": "build/out/schemas/typescript",
        "@root": "."
    }
}
